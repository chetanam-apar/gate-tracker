# Copy this file to ".env" and fill in your values.
# NEVER commit the real .env file to GitHub (it's blocked in .gitignore).

# How much detail in logs: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Path to the settings file (leave empty to use ./config.yaml)
CONFIG_PATH=

