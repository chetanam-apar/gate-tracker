# Copy this file to ".env" and fill in your values.
# NEVER commit the real .env file to GitHub (it's blocked in .gitignore).

# How much detail in logs: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Path to the settings file (leave empty to use ./config.yaml)
CONFIG_PATH=

# --- Database (Step 2) ---
# Used by docker-compose.yml to create the database
POSTGRES_USER=gametracker
POSTGRES_PASSWORD=change_me_to_something_long
POSTGRES_DB=gametracker
# Used by the Python app to connect. Password here must match the one above.
DATABASE_URL=postgresql+psycopg://gametracker:change_me_to_something_long@localhost:5432/gametracker

# --- Added in later steps ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
